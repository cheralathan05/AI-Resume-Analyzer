{
  "name": "ai-resume-analyzer-backend",
  "version": "1.0.0",
  "description": "Production-ready Express backend for the AI Resume Analyzer (health check + resume file upload).",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "nodemonConfig": {
    "watch": ["src/"],
    "ignore": ["src/uploads/**", "data/**", "*.json"],
    "ext": "js,mjs,cjs"
  },

  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "resume",
    "upload"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.18.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "form-data": "^4.0.6",
    "helmet": "^7.1.0",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.4"
  }
}
